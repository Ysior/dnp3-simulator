<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ustala architekturę pod natywne DLLe DNP3 -->
    <PlatformTarget>x64</PlatformTarget> 
  </PropertyGroup>

  <ItemGroup>
    <!-- Paczka NuGet dla OpenDNP3 -->
    <PackageReference Include="opendnp3" Version="3.1.2" /> 
  </ItemGroup>

  <ItemGroup>
   
    <ProjectReference Include="..\..\SimulatorAPI\ModuleAPI.csproj" />
    <ProjectReference Include="..\..\DNP3\API\DNP3.API.csproj" />
    <ProjectReference Include="..\..\DNP3\Commons\Commons.csproj" />
  </ItemGroup>

</Project>
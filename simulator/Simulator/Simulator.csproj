<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType> 
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Automatak.Simulator</RootNamespace>
    <AssemblyName>SimulatorApplication</AssemblyName>
    <ApplicationIcon>automatak.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="opendnp3" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Commons\Commons.csproj" />
    <ProjectReference Include="..\DNP3\DNP3Simulator\DNP3Module.csproj" />
    <ProjectReference Include="..\SimulatorAPI\ModuleAPI.csproj" />
    <ProjectReference Include="..\SimulatorUI\SimulatorUI.csproj" />
  </ItemGroup>
</Project>